rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow get: if signedIn() && request.auth.uid == adminId;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow list, delete: if isAdmin();
    }

    match /licenses/{licenseId} {
      allow read, write: if isAdmin();
      allow get, list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "licenseKey",
          "sourceCode",
          "ownerUid",
          "email",
          "productId",
          "plan",
          "status",
          "durationDays",
          "maxDevices",
          "devices",
          "deviceCount",
          "redeemedAt",
          "createdAt",
          "updatedAt"
        ]) &&
        licenseId == request.resource.data.licenseKey &&
        request.resource.data.sourceCode == licenseId &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.status == "active" &&
        request.resource.data.devices is list &&
        request.resource.data.deviceCount == 0 &&
        request.resource.data.productId == get(/databases/$(database)/documents/redeemCodes/$(licenseId)).data.productId &&
        request.resource.data.plan == get(/databases/$(database)/documents/redeemCodes/$(licenseId)).data.plan &&
        request.resource.data.durationDays == get(/databases/$(database)/documents/redeemCodes/$(licenseId)).data.durationDays &&
        request.resource.data.maxDevices == get(/databases/$(database)/documents/redeemCodes/$(licenseId)).data.maxDevices &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.redeemedAt == request.time &&
        get(/databases/$(database)/documents/redeemCodes/$(licenseId)).data.status == "available" &&
        getAfter(/databases/$(database)/documents/redeemCodes/$(licenseId)).data.status == "redeemed" &&
        getAfter(/databases/$(database)/documents/redeemCodes/$(licenseId)).data.redeemedBy == request.auth.uid;
    }

    match /redeemCodes/{codeId} {
      allow read, write: if isAdmin();
      allow get: if signedIn();
      allow update: if signedIn() &&
        resource.data.status == "available" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "redeemedBy",
          "redeemedByEmail",
          "redeemedAt",
          "updatedAt"
        ]) &&
        request.resource.data.status == "redeemed" &&
        request.resource.data.redeemedBy == request.auth.uid &&
        request.resource.data.redeemedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    match /licenseEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

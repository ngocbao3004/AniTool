rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow list, delete: if false;
    }

    match /licenses/{licenseId} {
      allow get: if signedIn() &&
        (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.status == "available"
        );

      allow list: if signedIn() &&
        resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn() &&
        resource.data.status == "available" &&
        resource.data.ownerUid == "" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "ownerUid",
          "email",
          "status",
          "activatedAt",
          "updatedAt"
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.status == "active" &&
        request.resource.data.activatedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    match /licenseEvents/{eventId} {
      allow read, write: if false;
    }

    match /productReleases/{productId} {
      allow read, write: if false;
    }

    match /adminAuditEvents/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
